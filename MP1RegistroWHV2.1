Sub ImprimirEtiquetaDesdeBarTender(Optional peso As Double = 0, Optional numeroCaja As Integer = 0)
    Dim btApp As Object
    Dim btFormat As Object
    Dim rutaEtiqueta As String
    Dim maxIntentos As Integer
    Dim intento As Integer
    Dim conexionExitosa As Boolean
    Dim camposRequeridos As Variant
    Dim i As Integer
    Const NOMBRE_CAMPO_PESO As String = "PESO"
    Const NOMBRE_CAMPO_ORDEN As String = "ORDEN_TRABAJO"
    Const NOMBRE_CAMPO_OPERADOR As String = "OPERADOR"
    Const NOMBRE_CAMPO_FECHA As String = "FECHA"
    Const NOMBRE_CAMPO_HORA As String = "HORA"
    Const NOMBRE_CAMPO_CAJA As String = "NUMERO_CAJA"
    
    On Error GoTo ErrorHandler
    
    ' Configuración inicial
    maxIntentos = 3
    conexionExitosa = False
    
    ' Ruta al archivo de etiqueta (ajusta según tu ubicación real)
    rutaEtiqueta = "C:\Users\MEXPO\Documents\BarTender\LBX-E0089-U-001.btw"
    
    ' Verificar que el archivo de etiqueta existe
    If Dir(rutaEtiqueta) = "" Then
        MsgBox "No se encontró el archivo de etiqueta en:" & vbCrLf & rutaEtiqueta & vbCrLf & vbCrLf & _
               "Por favor verifica la ruta y nombre del archivo.", vbCritical
        Exit Sub
    End If
    
    ' Si no se proporcionó peso, intentar obtener el último registro
    If peso = 0 Then
        peso = ObtenerUltimoPesoRegistrado()
        If peso = 0 Then
            MsgBox "No se encontró un peso válido para imprimir", vbExclamation
            Exit Sub
        End If
    End If
    
    ' Intentar conectar con BarTender (con múltiples intentos)
    For intento = 1 To maxIntentos
        On Error Resume Next
        ' Probar diferentes versiones de la API
        Set btApp = CreateObject("BarTender.Application.10") ' Para versiones recientes
        If btApp Is Nothing Then
            Set btApp = CreateObject("BarTender.Application.8") ' Para BarTender 2016 R8
        End If
        If btApp Is Nothing Then
            Set btApp = CreateObject("BarTender.Application") ' Versión genérica
        End If
        On Error GoTo ErrorHandler
        
        If Not btApp Is Nothing Then
            conexionExitosa = True
            Exit For
        End If
        
        Application.Wait Now + TimeValue("00:00:01") ' Esperar 1 segundo entre intentos
    Next intento
    
    If Not conexionExitosa Then
        MsgBox "No se pudo conectar con BarTender después de " & maxIntentos & " intentos." & vbCrLf & _
               "Por favor verifica que:" & vbCrLf & _
               "1. BarTender esté instalado correctamente" & vbCrLf & _
               "2. La licencia esté activa" & vbCrLf & _
               "3. No haya otras instancias bloqueando la aplicación", vbCritical
        Exit Sub
    End If
    
    ' Configurar BarTender (visible para depuración)
    btApp.Visible = True
    
    ' Abrir el formato de etiqueta
    Set btFormat = btApp.Formats.Open(rutaEtiqueta, False, "")
    If btFormat Is Nothing Then
        MsgBox "Se abrió BarTender pero no se pudo cargar la plantilla de etiqueta.", vbExclamation
        GoTo CleanUp
    End If
    
    ' Lista de campos a intentar asignar
    camposRequeridos = Array(NOMBRE_CAMPO_PESO, NOMBRE_CAMPO_ORDEN, NOMBRE_CAMPO_OPERADOR, _
                            NOMBRE_CAMPO_FECHA, NOMBRE_CAMPO_HORA, NOMBRE_CAMPO_CAJA)
    
    ' Verificar qué campos existen en la plantilla
    For i = LBound(camposRequeridos) To UBound(camposRequeridos)
        On Error Resume Next
        btFormat.SetNamedSubStringValue camposRequeridos(i), "TEST"
        If Err.Number <> 0 Then
            Debug.Print "Campo no encontrado: " & camposRequeridos(i)
            Err.Clear
        End If
        On Error GoTo ErrorHandler
    Next i
    
    ' Asignar valores a los campos (solo si existen)
    With btFormat
        ' Campo PESO (requerido)
        .SetNamedSubStringValue NOMBRE_CAMPO_PESO, Format(peso, "0.000") & " kg"
        
        ' Campo ORDEN (opcional)
        If OrdenTrabajoActual <> "" Then
            On Error Resume Next
            .SetNamedSubStringValue NOMBRE_CAMPO_ORDEN, OrdenTrabajoActual
            Err.Clear
        End If
        
        ' Campo OPERADOR (opcional)
        If OperadorActual <> "" Then
            On Error Resume Next
            .SetNamedSubStringValue NOMBRE_CAMPO_OPERADOR, OperadorActual
            Err.Clear
        End If
        
        ' Campos FECHA y HORA (opcionales)
        On Error Resume Next
        .SetNamedSubStringValue NOMBRE_CAMPO_FECHA, Format(Now, "dd/mm/yyyy")
        .SetNamedSubStringValue NOMBRE_CAMPO_HORA, Format(Now, "hh:mm:ss")
        Err.Clear
        
        ' Campo NUMERO_CAJA (opcional)
        If numeroCaja > 0 Then
            On Error Resume Next
            .SetNamedSubStringValue NOMBRE_CAMPO_CAJA, "Caja " & numeroCaja
            Err.Clear
        End If
        
        ' Imprimir la etiqueta (1 copia)
        .PrintOut False, 1
    End With
    
    MsgBox "Etiqueta impresa correctamente" & vbCrLf & _
           "Peso: " & Format(peso, "0.000") & " kg" & vbCrLf & _
           IIf(numeroCaja > 0, "Caja: " & numeroCaja & vbCrLf, "") & _
           "Fecha: " & Format(Now, "dd/mm/yyyy hh:mm"), vbInformation
    
CleanUp:
    ' Cerrar objetos
    If Not btFormat Is Nothing Then
        btFormat.Close btDoNotSaveChanges
        Set btFormat = Nothing
    End If
    
    ' Opcional: Cerrar BarTender (comentar si quieres dejarlo abierto)
    'If Not btApp Is Nothing Then
    '    btApp.Quit btDoNotSaveChanges
    '    Set btApp = Nothing
    'End If
    
    Exit Sub
    
ErrorHandler:
    ' Manejo detallado de errores
    Dim mensajeError As String
    mensajeError = "Error al imprimir etiqueta:" & vbCrLf & vbCrLf & _
                   "Código: " & Err.Number & vbCrLf & _
                   "Descripción: " & Err.Description & vbCrLf & vbCrLf & _
                   "Sugerencias:" & vbCrLf & _
                   "1. Verifica que BarTender esté instalado" & vbCrLf & _
                   "2. Comprueba los nombres de los campos en la plantilla" & vbCrLf & _
                   "3. Asegúrate que el archivo .btw no esté corrupto"
    
    MsgBox mensajeError, vbCritical
    Resume CleanUp
End Sub

Function ObtenerUltimoPesoRegistrado() As Double
    Dim wsRegistro As Worksheet
    Dim ultimaFila As Long
    
    On Error Resume Next
    Set wsRegistro = ThisWorkbook.Sheets("Registro de pesos por caja")
    On Error GoTo 0
    
    If wsRegistro Is Nothing Then
        ObtenerUltimoPesoRegistrado = 0
        Exit Function
    End If
    
    ultimaFila = wsRegistro.Cells(wsRegistro.Rows.Count, "C").End(xlUp).row
    
    If ultimaFila < 2 Then
        ObtenerUltimoPesoRegistrado = 0
    Else
        ObtenerUltimoPesoRegistrado = wsRegistro.Cells(ultimaFila, "C").Value
    End If
End Function

Sub ImprimirPesoDesdeSeleccion()
    Dim wsRegistro As Worksheet
    Dim filaSeleccionada As Long
    Dim rangoSeleccion As Range
    Dim pesoSeleccionado As Double
    Dim fechaHora As String
    Dim operador As String
    Dim ordenTrabajo As String
    
    ' Configurar hoja de registro
    Set wsRegistro = ThisWorkbook.Sheets("Registro de pesos por caja")
    
    ' Verificar que la selección esté en la hoja correcta
    If Not Application.Intersect(ActiveSheet.Range("A:D"), Selection) Is Nothing Then
        If ActiveSheet.Name <> "Registro de pesos por caja" Then
            MsgBox "Por favor seleccione una celda en la hoja 'Registro de pesos por caja'", vbExclamation
            Exit Sub
        End If
    Else
        ' Si no hay selección válida, usar la celda activa
        If ActiveSheet.Name <> "Registro de pesos por caja" Then
            MsgBox "Por favor active la hoja 'Registro de pesos por caja' y seleccione una fila", vbExclamation
            Exit Sub
        End If
    End If
    
    ' Determinar la fila seleccionada
    Set rangoSeleccion = Selection
    filaSeleccionada = rangoSeleccion.row
    
    ' Verificar que no sea la fila de encabezados
    If filaSeleccionada = 1 Then
        MsgBox "Por favor seleccione una fila con datos, no el encabezado", vbExclamation
        Exit Sub
    End If
    
    ' Verificar que haya datos en la fila seleccionada
    If wsRegistro.Cells(filaSeleccionada, "C").Value = "" Then
        MsgBox "No hay datos de peso en la fila seleccionada", vbExclamation
        Exit Sub
    End If
    
    ' Obtener datos de la fila seleccionada
    With wsRegistro
        pesoSeleccionado = .Cells(filaSeleccionada, "C").Value
        fechaHora = .Cells(filaSeleccionada, "B").Text
        operador = .Cells(filaSeleccionada, "D").Value
        ordenTrabajo = .Cells(filaSeleccionada, "A").Value
    End With
    
    ' Mostrar confirmación
    Dim mensajeConfirmacion As String
    mensajeConfirmacion = "¿Imprimir etiqueta con los siguientes datos?" & vbCrLf & vbCrLf & _
                         "Orden: " & ordenTrabajo & vbCrLf & _
                         "Peso: " & Format(pesoSeleccionado, "0.000") & " kg" & vbCrLf & _
                         "Fecha: " & fechaHora & vbCrLf & _
                         "Operador: " & operador
    
    If MsgBox(mensajeConfirmacion, vbQuestion + vbYesNo, "Confirmar impresión") = vbYes Then
        ' Guardar valores temporales
        Dim operadorTemp As String, ordenTemp As String
        operadorTemp = OperadorActual
        ordenTemp = OrdenTrabajoActual
        
        ' Asignar valores de la fila seleccionada
        OperadorActual = operador
        OrdenTrabajoActual = ordenTrabajo
        
        ' Llamar a la función de impresión
        ImprimirEtiquetaDesdeBarTender pesoSeleccionado
        
        ' Restaurar valores originales
        OperadorActual = operadorTemp
        OrdenTrabajoActual = ordenTemp
    End If
End Sub

' ======= Subrutina para el botón "Regresar a la Orden de Trabajo" =======
Sub RegresarAOrden()
    Dim wsRegistro As Worksheet
    Dim ws As Worksheet
    Dim ultimaFila As Long
    Dim otBuscada As String
    Dim hojaEncontrada As Boolean
    
    ' 1. Conectar con la hoja de registros
    On Error Resume Next
    Set wsRegistro = ThisWorkbook.Sheets("Registro de pesos por caja")
    On Error GoTo 0
    
    If wsRegistro Is Nothing Then
        MsgBox "No se encontró la hoja de registros.", vbCritical, "Error"
        Exit Sub
    End If
    
    ' 2. Encontrar la última fila con datos en la Columna A
    ultimaFila = wsRegistro.Cells(wsRegistro.Rows.Count, "A").End(xlUp).row
    
    If ultimaFila < 2 Then
        MsgBox "No hay registros en la tabla para saber a dónde regresar.", vbExclamation, "Sin datos"
        Exit Sub
    End If
    
    ' 3. Extraer el nombre de la O.T. del último registro impreso
    otBuscada = Trim(wsRegistro.Cells(ultimaFila, "A").Value)
    
    If otBuscada = "" Then
        MsgBox "El último registro no contiene una O.T. válida en la Columna A.", vbExclamation, "Falta O.T."
        Exit Sub
    End If
    
    hojaEncontrada = False
    
    ' 4. Buscar qué hoja de producción pertenece a esta O.T.
    For Each ws In ThisWorkbook.Worksheets
        ' Excluimos las hojas de sistema para no buscar donde no se debe
        Select Case ws.Name
            Case "Generador de plantillas", "PLANTILLA", "Registro de pesos por caja", "Historial"
                ' Ignorar estas hojas
            Case Else
                ' Si la celda G1 de la hoja coincide con la O.T. que buscamos...
                If Trim(ws.Range("G1").Value) = otBuscada Then
                    ws.Activate
                    hojaEncontrada = True
                    Exit For
                End If
        End Select
    Next ws
    
    ' 5. Si por alguna razón la hoja ya fue eliminada o no existe
    If Not hojaEncontrada Then
        MsgBox "No se encontró ninguna hoja de escaneo activa para la O.T.: " & otBuscada, vbInformation, "Hoja no encontrada"
    End If
End Sub

