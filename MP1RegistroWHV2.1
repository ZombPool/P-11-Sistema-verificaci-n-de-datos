' =========================================================================
' === FUNCIÓN: BUSCAR REPORTE OFICIAL FQC Y EXTRAER ID ====================
' =========================================================================
Function ObtenerIdLiberacionFQC(ot_num As String) As String
    Dim basePath As String, filePath As String
    Dim wbReporte As Workbook, wsReporte As Worksheet
    Dim fso As Object
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    ' 1. Buscar en la carpeta donde Python guarda los Reportes de Auditoría (FQC)
    basePath = Environ("USERPROFILE") & "\Documents\LIBERACIONES FQC\"
    filePath = basePath & "Reporte_VERIF_JMO-" & ot_num & ".xlsx"
    
    ' Alternativas por si tienen OneDrive activado
    If Not fso.FileExists(filePath) Then
        filePath = Environ("USERPROFILE") & "\OneDrive\Documents\LIBERACIONES FQC\Reporte_VERIF_JMO-" & ot_num & ".xlsx"
    End If
    If Not fso.FileExists(filePath) Then
        filePath = Environ("USERPROFILE") & "\OneDrive\Documents\LIBERACIONES FQC\Reporte_VERIF_JMO-" & ot_num & ".xlsx"
    End If

    ' Si el archivo oficial no existe, significa que FQC no ha cerrado la O.T.
    If Not fso.FileExists(filePath) Then
        ObtenerIdLiberacionFQC = ""
        Exit Function
    End If

    ' 2. Abrir el archivo oficial en modo invisible
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Set wbReporte = Workbooks.Open(filePath, ReadOnly:=True)
    
    ' 3. Buscar en la pestaña "Resumen O.T." (donde está el recuadro azul de Python)
    On Error Resume Next
    Set wsReporte = wbReporte.Sheets("Resumen O.T.")
    On Error GoTo 0
    
    If Not wsReporte Is Nothing Then
        Dim valE8 As String
        valE8 = wsReporte.Range("E8").Value ' Celda donde Python imprime el ID
        
        ' Validar si contiene la nomenclatura oficial
        If InStr(valE8, "REP-FQC-") > 0 Then
            ' Limpiamos el texto para devolver solo el ID puro
            ObtenerIdLiberacionFQC = Trim(Replace(valE8, "ID de Liberación:", ""))
        Else
            ObtenerIdLiberacionFQC = "" ' Archivo existe, pero no fue aprobado/liberado oficialmente
        End If
    Else
        ObtenerIdLiberacionFQC = ""
    End If
    
    ' Cerrar archivo sin guardar
    wbReporte.Close False
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True
End Function



