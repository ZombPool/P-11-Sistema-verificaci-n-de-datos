#Sheet1 (Generador de plantillas)
' ============================== V3.0 =========================================
' === VARIABLES DE MEMORIA CACHÉ PARA SELLOS DIGITALES ====================
' =========================================================================
Private dictSellos As Object
Private lastLoadedOrder_SCLC As String

' =========================================================================
' === ACTIVAR PERMISOS ESPECIALES PARA MACROS AL ABRIR EL ARCHIVO =========
' =========================================================================
Private Sub Workbook_Open()
    Dim ws As Worksheet
    For Each ws In ThisWorkbook.Worksheets
        ' Solo aplicamos el candado inteligente a la Plantilla y a las O.T.s generadas
        If Left(ws.Name, 3) = "ORD" Or ws.Name = "PLANTILLA" Then
            ws.Protect password:="1234", UserInterfaceOnly:=True
        End If
    Next ws
End Sub

' =========================================================================
' === EVENTO PRINCIPAL ====================================================
' =========================================================================
Private Sub Workbook_SheetChange(ByVal Sh As Object, ByVal Target As Range)
    ' Si se seleccionan múltiples celdas, salimos
    If Target.Cells.CountLarge > 1 Then Exit Sub

    ' Hojas excluidas
    Select Case Sh.Name
        Case "Generador de plantillas", "PLANTILLA", "Registro de pesos por caja", "Historial"
            Exit Sub
    End Select

    Application.EnableEvents = False
    On Error GoTo SafeExit

    ' ---------------------------------------------------------------------
    ' CASO 1: LÍNEA DE PRODUCCIÓN (COLUMNA A)
    ' ---------------------------------------------------------------------
    If Not Intersect(Target, Sh.Columns("A")) Is Nothing Then
        ' Parámetros de Columnas: B(2)=Desc, C(3)=Sello, D(4)=Fecha, E(5)=Estatus
        Call ProcessScannedSerial(Target, 2, 3, 4, 6)
    End If

SafeExit:
    Application.EnableEvents = True
End Sub

' =========================================================================
' === SUBRUTINA: PRODUCCIÓN (Escaneo en A -> Cruce con Calidad) ===========
' =========================================================================
Private Sub ProcessScannedSerial(ByVal targetCell As Range, ByVal descCol As Long, ByVal sealCol As Long, ByVal dateCol As Long, ByVal statusCol As Long)
    Dim ws As Worksheet: Set ws = targetCell.Worksheet
    Dim row As Long: row = targetCell.row
    Dim scanColLetter As String: scanColLetter = Split(targetCell.Address(True, False), "$")(0)

    If targetCell.Value = "" Then
        LimpiarCampos targetCell, descCol, sealCol, dateCol, statusCol
        Exit Sub
    End If

    ' Validación Formato Inicial
    ' Apuntamos el error hacia descCol (Columna B) para que el operador lo vea de inmediato
    If UCase(Left(targetCell.Value, 3)) <> "TEV" And UCase(Left(targetCell.Value, 3)) <> "JMO" Then
        ws.Cells(row, descCol).Value = "Formato incorrecto"
        Exit Sub
    End If

    Dim numeroSerie As String, scannedOrder As String, sheetOrder As String
    
    ' Fecha de escaneo
    If ws.Cells(row, dateCol).Value = "" Then
        ws.Cells(row, dateCol).Value = Format(Now, "dd/mm/yy hh:mm")
    End If

    ' Validación de 13 dígitos
    numeroSerie = ExtraerNumeros(targetCell.Value)
    If Len(numeroSerie) <> 13 Then
        MsgBox "El número de serie debe contener 13 dígitos numéricos.", vbExclamation, "Error de Formato"
        LimpiarCampos targetCell, descCol, sealCol, dateCol, statusCol
        Exit Sub
    End If

    ' Validación de O.T. contra el encabezado de la hoja (G1)
    scannedOrder = Mid(numeroSerie, 1, 9)
    sheetOrder = Mid(ws.Range("G1").Value, 5, 9)
    If scannedOrder <> sheetOrder Then
        MsgBox "ESTE NÚMERO DE SERIE NO CORRESPONDE A LA ORDEN DE TRABAJO DE ESTA HOJA", vbCritical, "Cruce de O.T."
        LimpiarCampos targetCell, descCol, sealCol, dateCol, statusCol
        Exit Sub
    End If

    ' --- VERIFICACIÓN DE DUPLICADOS ---
    ' Apuntamos la alerta hacia descCol (Columna B) en lugar de statusCol
    If VerificarDuplicados(targetCell, scanColLetter, descCol) Then
        Exit Sub
    End If

    ' =====================================================================
    ' === MAGIA DE TRAZABILIDAD: CRUCE CON REPORTE DE AUDITORÍA (PYTHON) ==
    ' =====================================================================
    
    ' 1. Cargar el reporte de la O.T. en memoria (Solo si no está cargado ya)
    If scannedOrder <> lastLoadedOrder_SCLC Then
        If Not CargarReporteEmpaque(scannedOrder) Then ' <--- CAMBIO DE NOMBRE
            LimpiarCampos targetCell, descCol, sealCol, dateCol, statusCol
            Exit Sub
        End If
    End If
    
    ' 2. Buscar el cable en la memoria caché
    Dim selloDigital As String
    If dictSellos.Exists(numeroSerie) Then
        selloDigital = dictSellos(numeroSerie)
        
        ' Poka-Yoke: Evitar empaque de chatarra o rechazados
        If selloDigital = "BLOQUEADO" Then
            MsgBox "? CABLE BLOQUEADO POR CALIDAD ?" & vbCrLf & vbCrLf & _
                   "El N.S. " & numeroSerie & " fue clasificado como RECHAZADO o SCRAP en la Auditoría Oficial." & vbCrLf & _
                   "Retira este cable de la línea inmediatamente.", vbCritical, "Alerta de Calidad"
            LimpiarCampos targetCell, descCol, sealCol, dateCol, statusCol
            Exit Sub
        End If
    
     ' =====================================================================
        ' === NUEVO POKA-YOKE: VALIDACIÓN DE SELLO DIGITAL VACÍO/INEXISTENTE ==
        ' =====================================================================
        If InStr(1, UCase(selloDigital), "SIN SELLO") > 0 Or _
           InStr(1, UCase(selloDigital), "ERROR") > 0 Or _
           InStr(1, UCase(selloDigital), "NO REGISTRADO") > 0 Or _
           Trim(selloDigital) = "" Or UCase(selloDigital) = "N/A" Then

            MsgBox "?? CABLE SIN SELLO DIGITAL ??" & vbCrLf & vbCrLf & _
                   "El N.S. " & numeroSerie & " NO TIENE un Sello Digital válido asignado en la Base de Datos." & vbCrLf & _
                   "Envíe este cable a Verificación Individual para ser escaneado y sellado antes de empacar.", vbCritical, "Seguridad de Trazabilidad"

            LimpiarCampos targetCell, descCol, sealCol, dateCol, statusCol
            Exit Sub
        End If
        ' =====================================================================
    
    Else
        ' Si no existe, es porque Calidad no lo reportó ni siquiera como faltante
        MsgBox "?? CABLE NO AUDITADO ??" & vbCrLf & vbCrLf & _
               "El N.S. " & numeroSerie & " no existe en el reporte de liberación de esta O.T." & vbCrLf & _
               "Contacte a Calidad.", vbExclamation, "Cable Desconocido"
        LimpiarCampos targetCell, descCol, sealCol, dateCol, statusCol
        Exit Sub
    End If

    ' =====================================================================

    ' Si todo está perfecto, llenamos la fila
    ws.Cells(row, descCol).Value = ObtenerDescripcionProducto(scannedOrder)
    ws.Cells(row, sealCol).Value = selloDigital ' <--- AQUI SE PEGA EL SELLO
    ws.Cells(row, statusCol).Value = "OK"
    
' =========================================================================
    ' === POKA-YOKE 3: VALIDACIÓN DE ÚLTIMA PIEZA Y LIBERACIÓN FQC ============
    ' =========================================================================
    Dim totalEsperado As Long
    Dim escaneosActuales As Long
    Dim arrTemp() As String

    ' 1. Extraer el total esperado de G2 (Ej: "Cantidad de productos a escanear: 55")
    On Error Resume Next
    arrTemp = Split(ws.Range("G2").Value, ": ")
    If UBound(arrTemp) >= 1 Then totalEsperado = CLng(arrTemp(1))
    
    ' 2. Contar cuántos códigos válidos hay en la columna A en este momento
    Dim lastScanRow As Long
    lastScanRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).row
    If lastScanRow >= 3 Then
        escaneosActuales = Application.WorksheetFunction.CountA(ws.Range("A3:A" & lastScanRow))
    Else
        escaneosActuales = 0
    End If
    On Error GoTo 0

    ' 3. Si el operador está intentando escanear la ÚLTIMA pieza del total...
    If totalEsperado > 0 And escaneosActuales = totalEsperado Then
        Dim idFQC As String
        idFQC = ObtenerIdLiberacionFQC(scannedOrder)

        ' Si no existe el reporte oficial de Calidad o no tiene ID...
        If idFQC = "" Then
            MsgBox "O.T. Falta de liberación, contacte con el área de FQC para que puedan liberarle la O.T. JMO-" & scannedOrder, vbCritical, "Bloqueo de Cierre"
            LimpiarCampos targetCell, descCol, sealCol, dateCol, statusCol
            Exit Sub
        Else
            ' Si FQC ya liberó, extraemos el ID y lo pegamos en H1
            ws.Range("H1").Value = "ID: " & idFQC
            ws.Range("H1").Font.Bold = True
            ws.Range("H1").Font.color = RGB(0, 102, 204)
        End If
    End If
    ' =========================================================================
    
' =========================================================================
    ' === POKA-YOKE 1: ALERTA DE FIN DE CAJA Y REDIRECCIÓN A BÁSCULA ==========
    ' =========================================================================
    Dim cajaRange As Range
    Set cajaRange = ws.Cells(row, "E").MergeArea
    
    If cajaRange.row + cajaRange.Rows.Count - 1 = row Then
        ' 1. Mostramos el mensaje
        MsgBox "Para continuar, imprime la etiqueta de la caja en la báscula.", vbInformation, "Caja Completada"
        
        ' 2. Guardamos en la memoria cómo se llama la hoja actual (Ej. ORD-260400006-10FT)
        HojaOrigenEscaneo = ws.Name
        
        ' 3. Teletransportamos al operador a la hoja de la báscula
        On Error Resume Next
        ThisWorkbook.Sheets("Registro de pesos por caja").Activate
        On Error GoTo 0
    End If

    ' =========================================================================
    ' === POKA-YOKE 2: ALERTA DE FIN DE LOTE (Suma de entregas parciales) =====
    ' =========================================================================
    Dim totalEntregado As Long
    Dim totalEscaneado As Long
    Dim filaH As Long
    
    ' 1. Sumamos todas las piezas entregadas en la columna H a partir de la fila 37
    totalEntregado = 0
    filaH = 37
    Do While ws.Range("G" & filaH).Value <> ""
        Dim valH As String
        valH = ws.Range("H" & filaH).Value
        valH = Replace(valH, " Pzs", "") ' Le quitamos el texto " Pzs" para poder sumar
        If IsNumeric(valH) Then
            totalEntregado = totalEntregado + CLng(valH)
        End If
        filaH = filaH + 2 ' Saltamos de 2 en 2 porque están combinadas
    Loop
    
    ' 2. Evaluamos usando el lastScanRow que YA calculamos arriba en el Poka-Yoke 3
    If lastScanRow >= 3 Then
        totalEscaneado = Application.WorksheetFunction.CountA(ws.Range("A3:A" & lastScanRow))
        
        ' 3. Si la cantidad escaneada alcanza EXACTAMENTE la suma de lo entregado, lanzamos alerta
        If totalEscaneado = totalEntregado And totalEntregado > 0 Then
            MsgBox "Terminaste de escanear el lote de " & totalEntregado & " piezas." & vbCrLf & vbCrLf & _
                   "Verifica que tu cantidad escaneada coincida con la cantidad entregada físicamente.", _
                   vbExclamation, "Lote de Producción Completado"
        End If
    End If

End Sub

' =========================================================================
' === MOTOR DE LECTURA DE REPORTE (EXTRACCIÓN DE SELLOS EMPAQUE) ==========
' =========================================================================
Function CargarReporteEmpaque(ot_num As String) As Boolean
    Dim basePath As String, filePath As String
    Dim wbReporte As Workbook, wsReporte As Worksheet
    Dim lastRow As Long, i As Long
    Dim nsCable As String, selloBD As String, estadoFinal As String
    Dim fso As Object
    
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    ' Instanciar el diccionario
    If dictSellos Is Nothing Then Set dictSellos = CreateObject("Scripting.Dictionary")
    dictSellos.RemoveAll

    ' 1. Encontrar la ruta del Escritorio donde Python guardó el Excel de LOTE
    basePath = Environ("USERPROFILE") & "\Desktop\Reportes de Lote Empaque\"
    filePath = basePath & "Reporte_LOTE_JMO-" & ot_num & ".xlsx"
    
    ' Intento 2: Si tienen OneDrive activado
    If Not fso.FileExists(filePath) Then
        filePath = Environ("USERPROFILE") & "\OneDrive\Escritorio\Reportes de Lote Empaque\Reporte_LOTE_JMO-" & ot_num & ".xlsx"
    End If
    
    ' Intento 3: En inglés
    If Not fso.FileExists(filePath) Then
        filePath = Environ("USERPROFILE") & "\OneDrive\Desktop\Reportes de Lote Empaque\Reporte_LOTE_JMO-" & ot_num & ".xlsx"
    End If

    If Not fso.FileExists(filePath) Then
        MsgBox "No se encontró el Reporte de Lote para la O.T. JMO-" & ot_num & vbCrLf & vbCrLf & _
               "Asegúrese de haber generado el reporte en la herramienta 'Revisar Lote' de FibraTrace.", vbCritical, "Falta Reporte de Empaque"
        CargarReporteEmpaque = False
        Exit Function
    End If

    ' 2. Abrir el archivo en modo oculto y de solo lectura
    Application.ScreenUpdating = False
    Application.DisplayAlerts = False
    Set wbReporte = Workbooks.Open(filePath, ReadOnly:=True)
    
    ' Apuntamos a la pestaña correcta generada por la nueva herramienta
    On Error Resume Next
    Set wsReporte = wbReporte.Sheets("Extracción de Sellos")
    On Error GoTo 0
    
    If Not wsReporte Is Nothing Then
        lastRow = wsReporte.Cells(wsReporte.Rows.Count, "A").End(xlUp).row
        
        ' 3. Extraer N.S., Sellos y Estados (Empieza en Fila 2)
        For i = 2 To lastRow
            nsCable = ExtraerNumeros(wsReporte.Cells(i, 1).Value)
            selloBD = wsReporte.Cells(i, 2).Value
            estadoFinal = UCase(Trim(wsReporte.Cells(i, 3).Value))
            
            If Len(nsCable) = 13 Then
                If estadoFinal = "APROBADO" Then
                    dictSellos(nsCable) = selloBD
                Else
                    ' Si es RECHAZADO, INTRUSO, FALTANTE o SCRAP, lo bloqueamos
                    dictSellos(nsCable) = "BLOQUEADO"
                End If
            End If
        Next i
    End If
    
    wbReporte.Close False
    Application.DisplayAlerts = True
    Application.ScreenUpdating = True

    lastLoadedOrder_SCLC = ot_num
    CargarReporteEmpaque = True
End Function


' =========================================================================
' === FUNCIONES AUXILIARES ================================================
' =========================================================================
Sub LimpiarCampos(ByVal targetCell As Range, ByVal descCol As Long, ByVal sealCol As Long, ByVal dateCol As Long, ByVal statusCol As Long)
    Dim ws As Worksheet, row As Long
    Set ws = targetCell.Worksheet
    row = targetCell.row
    
    targetCell.ClearContents
    ws.Cells(row, descCol).ClearContents
    ws.Cells(row, sealCol).ClearContents
    ws.Cells(row, dateCol).ClearContents
    ws.Cells(row, statusCol).ClearContents
End Sub

Function VerificarDuplicados(ByVal targetCell As Range, ByVal scanColLetter As String, ByVal statusCol As Long) As Boolean
    Dim ws As Worksheet, row As Long
    Set ws = targetCell.Worksheet
    row = targetCell.row
    VerificarDuplicados = False

    ' 1. Busca duplicados en la misma hoja
    Dim lastRow As Long, i As Long
    lastRow = ws.Cells(ws.Rows.Count, scanColLetter).End(xlUp).row
    For i = 3 To lastRow
        If i <> row And ws.Cells(i, scanColLetter).Value <> "" And ws.Cells(i, scanColLetter).Value = targetCell.Value Then
            ws.Cells(row, statusCol).Value = "DUPLICADO en esta hoja, fila " & i
            VerificarDuplicados = True
            Exit Function
        End If
    Next i

    ' 2. Busca duplicados en otras hojas
    Dim wsCheck As Worksheet
    For Each wsCheck In ThisWorkbook.Worksheets
        If wsCheck.Name <> ws.Name And (Left(wsCheck.Name, 3) = "ORD" Or Left(wsCheck.Name, 9) = "PLANTILLA") Then
            If Application.WorksheetFunction.CountIf(wsCheck.Columns(scanColLetter), targetCell.Value) > 0 Then
                Dim duplicateRow As Long
                duplicateRow = wsCheck.Columns(scanColLetter).Find(What:=targetCell.Value, LookIn:=xlValues, LookAt:=xlWhole).row
                ws.Cells(row, statusCol).Value = "DUPLICADO en hoja '" & wsCheck.Name & "', fila " & duplicateRow
                VerificarDuplicados = True
                Exit Function
            End If
        End If
    Next wsCheck
End Function

Function ExtraerNumeros(ByVal cadena As String) As String
    Dim i As Integer, caracter As String, resultado As String
    resultado = ""
    For i = 1 To Len(cadena)
        caracter = Mid(cadena, i, 1)
        If IsNumeric(caracter) Then resultado = resultado & caracter
    Next i
    ExtraerNumeros = resultado
End Function

