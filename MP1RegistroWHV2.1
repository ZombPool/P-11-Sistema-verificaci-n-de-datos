' =========================================================================
' === CONFIGURACIÓN GLOBAL ================================================
' =========================================================================
' Define la fila donde comienza la tabla de registro de lotes.
Private Const LOG_START_ROW As Long = 56
' Contraseña para proteger/desproteger la hoja. Cámbiala si lo deseas.
Private Const SHEET_PASSWORD As String = "PRODUCCION2025"

' =========================================================================
' === MACRO PRINCIPAL "Cerrar y Contar Lote" ==============================
' =========================================================================
Sub CerrarLote()
    Dim ws As Worksheet
    Set ws = ActiveSheet
    
    ' --- 1. ENCONTRAR Y CONTAR NUEVAS PIEZAS ---
    Dim lastRow As Long, startRow As Long, loteCount As Long
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).row
    startRow = FindLastColoredRow(ws, "A") + 1 ' La fila de inicio es la siguiente a la última coloreada en Col A
    
    If lastRow < startRow Then
        MsgBox "No hay nuevos productos escaneados para cerrar el lote.", vbInformation
        Exit Sub
    End If
    
    loteCount = Application.WorksheetFunction.CountA(ws.Range("A" & startRow & ":A" & lastRow))
    
    ' --- 2. MOSTRAR DIÁLOGO DE CONFIRMACIÓN ---
    Dim logNextRow As Long, newLoteNum As Long
    logNextRow = ws.Cells(ws.Rows.Count, "G").End(xlUp).row + 1
    If logNextRow < LOG_START_ROW Then logNextRow = LOG_START_ROW
    newLoteNum = logNextRow - LOG_START_ROW + 1
    
    Dim frm As New frmAccionLote
    frm.ShowConfirmation newLoteNum, loteCount
    
    If Not frm.userConfirmed Then Exit Sub
    
    Application.ScreenUpdating = False
    
    ' --- 3. PROCESAR Y BLOQUEAR EL LOTE ---
    ws.Unprotect password:=SHEET_PASSWORD
    
    Dim colorLote As Long
    Dim colores(0 To 2) As Long
    colores(0) = RGB(227, 242, 253)
    colores(1) = RGB(232, 245, 233)
    colores(2) = RGB(255, 249, 231)
    colorLote = colores((newLoteNum - 1) Mod 3)
    
    ws.Rows(logNextRow).RowHeight = 225
    With ws.Cells(logNextRow, "G")
        .Value = "LOTE " & newLoteNum & ": " & loteCount & " Piezas (Cerrado el " & Format(Now, "dd/mm/yy hh:mm") & ")"
        .HorizontalAlignment = xlLeft
        .VerticalAlignment = xlCenter
        .Font.Bold = True
        .Font.Size = 60
        .WrapText = True
        .BorderAround LineStyle:=xlContinuous, Weight:=xlThin
        .Interior.color = colorLote
    End With
    With ws.Cells(logNextRow, "H")
        .Font.Name = "IDAutomationHC39M Free Version"
        .Font.Size = 60
        .Value = "*" & loteCount & "*"
        .HorizontalAlignment = xlCenter
        .VerticalAlignment = xlCenter
        .BorderAround LineStyle:=xlContinuous, Weight:=xlThin
        .Interior.color = colorLote
    End With
    
    With ws.Range("A" & startRow & ":D" & lastRow)
        .Interior.color = colorLote
        .Locked = True
    End With
    
    ws.Protect password:=SHEET_PASSWORD, UserInterfaceOnly:=True
    
    Application.ScreenUpdating = True
    
    MsgBox "Lote " & newLoteNum & " cerrado y bloqueado con " & loteCount & " piezas.", vbInformation
    MsgBox "Por favor, envía inmediatamente el lote al área de empaque.", vbInformation, "Siguiente Paso"
    Call AddToHistory("CIERRE DE LOTE", "Lote " & newLoteNum & " cerrado con " & loteCount & " piezas.")
End Sub

' =========================================================================
' === MACRO "Confirmar Lote Empaque" ======================================
' =========================================================================
Sub ConfirmarLoteEmpaque()
    Dim ws As Worksheet
    Set ws = ActiveSheet
    
    Application.ScreenUpdating = False
    
    Dim prodLastRow As Long, prodStartRow As Long, loteColor As Long, lastLogEntryRow As Long
    lastLogEntryRow = ws.Cells(ws.Rows.Count, "G").End(xlUp).row
    If lastLogEntryRow < LOG_START_ROW Then
        MsgBox "No se ha cerrado ningún lote de Producción para verificar.", vbExclamation
        Exit Sub
    End If
    loteColor = ws.Cells(lastLogEntryRow, "G").Interior.color
    prodLastRow = FindLastColoredRowByColor(ws, loteColor)
    prodStartRow = FindFirstColoredRowByColor(ws, loteColor, prodLastRow)
    
    If prodStartRow = 0 Or prodLastRow = 0 Or prodStartRow > prodLastRow Then
        MsgBox "Error: No se pudo encontrar el bloque de productos coloreados en la columna A.", vbCritical
        Exit Sub
    End If
    
    Dim prodRng As Range
    Set prodRng = ws.Range("A" & prodStartRow & ":A" & prodLastRow)
    
    Dim empaqueLastRow As Long, empaqueStartRow As Long
    empaqueStartRow = FindLastColoredRow(ws, "J") + 1
    empaqueLastRow = ws.Cells(ws.Rows.Count, "J").End(xlUp).row
    
    If empaqueLastRow < empaqueStartRow Then
        MsgBox "No se han escaneado nuevos productos en el área de Empaque para verificar.", vbExclamation
        Application.ScreenUpdating = True
        Exit Sub
    End If
    
    Dim empaqueRng As Range
    Set empaqueRng = ws.Range("J" & empaqueStartRow & ":J" & empaqueLastRow)
    empaqueRng.Interior.ColorIndex = xlNone
    
    Dim dictProd As Object, dictEmpaque As Object, cell As Range
    Set dictProd = CreateObject("Scripting.Dictionary")
    Set dictEmpaque = CreateObject("Scripting.Dictionary")
    
    For Each cell In prodRng
        If cell.Value <> "" And Not dictProd.Exists(cell.Value) Then dictProd.Add cell.Value, cell.row
    Next cell
    
    Dim duplicadosEmpaque As String
    duplicadosEmpaque = ""
    For Each cell In empaqueRng
        If cell.Value <> "" Then
            If dictEmpaque.Exists(cell.Value) Then
                duplicadosEmpaque = duplicadosEmpaque & cell.Value & vbCrLf
                cell.Interior.color = RGB(255, 255, 0)
            Else
                dictEmpaque.Add cell.Value, cell.row
            End If
        End If
    Next cell
    
    Dim faltantesEnEmpaque As String, sobrantesEnEmpaque As String, key As Variant
    faltantesEnEmpaque = "": sobrantesEnEmpaque = ""
    
    For Each key In dictProd.Keys
        If Not dictEmpaque.Exists(key) Then faltantesEnEmpaque = faltantesEnEmpaque & key & vbCrLf
    Next key
    
    For Each key In dictEmpaque.Keys
        If Not dictProd.Exists(key) Then
            sobrantesEnEmpaque = sobrantesEnEmpaque & key & vbCrLf
            ws.Cells(dictEmpaque(key), "J").Interior.color = RGB(255, 199, 206)
        End If
    Next key
    
    If faltantesEnEmpaque = "" And sobrantesEnEmpaque = "" And duplicadosEmpaque = "" Then
        empaqueRng.Resize(, 4).Interior.color = loteColor
        MsgBox "? Verificación Exitosa" & vbCrLf & vbCrLf & _
               "El lote de Empaque coincide perfectamente con el de Producción." & vbCrLf & _
               "Total de piezas verificadas: " & dictProd.Count, vbInformation, "Verificación Completa"
        Call AddToHistory("VERIFICACIÓN EMPAQUE", "Éxito. Lote verificado con " & dictProd.Count & " piezas.")
    Else
        Dim errorMsg As String
        errorMsg = "?? Verificación Fallida. Se encontraron las siguientes discrepancias:" & vbCrLf & vbCrLf
        If faltantesEnEmpaque <> "" Then errorMsg = errorMsg & "--- FALTANTES EN EMPAQUE ---" & vbCrLf & faltantesEnEmpaque & vbCrLf
        If sobrantesEnEmpaque <> "" Then errorMsg = errorMsg & "--- SOBRANTES/INCORRECTOS EN EMPAQUE (resaltados en rojo) ---" & vbCrLf & sobrantesEnEmpaque & vbCrLf
        If duplicadosEmpaque <> "" Then errorMsg = errorMsg & "--- DUPLICADOS EN EMPAQUE (resaltados en amarillo) ---" & vbCrLf & duplicadosEmpaque
        MsgBox errorMsg, vbCritical, "Error en Verificación"
        Call AddToHistory("VERIFICACIÓN EMPAQUE", "Fallo. Se encontraron discrepancias.")
    End If
    
    Application.ScreenUpdating = True
End Sub

