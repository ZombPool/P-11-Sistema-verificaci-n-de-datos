' === MACRO "Desbloquear Lote" ============================================
' =========================================================================
Sub DesbloquearLote()
    Dim ws As Worksheet
    Set ws = ActiveSheet
    
    Dim password As String
    password = InputBox("Ingresa la contraseña para desbloquear el lote:", "Acceso Protegido")
    If password <> SHEET_PASSWORD Then
        MsgBox "Contraseña incorrecta. Operación cancelada.", vbCritical
        Exit Sub
    End If
    
    Dim loteNumStr As String, loteNumToUnlock As Long, logLastRow As Long
    logLastRow = ws.Cells(ws.Rows.Count, "G").End(xlUp).row
    
    If logLastRow < LOG_START_ROW Then
        MsgBox "No hay lotes registrados para desbloquear.", vbInformation
        Exit Sub
    End If
    
    loteNumStr = InputBox("Ingresa el NÚMERO del lote que deseas desbloquear (ej. 3):", "Desbloquear Lote")
    
    If loteNumStr = "" Then Exit Sub
    If Not IsNumeric(loteNumStr) Then
        MsgBox "Por favor, ingresa solo un número.", vbExclamation
        Exit Sub
    End If
    loteNumToUnlock = CLng(loteNumStr)
    
    Dim logRow As Long, i As Long, found As Boolean
    found = False
    For i = LOG_START_ROW To logLastRow
        Dim currentLoteText As String, currentLoteNum As Long
        currentLoteText = ws.Cells(i, "G").Value
        If Left(currentLoteText, 4) = "LOTE" Then
            currentLoteNum = CLng(Trim(Split(Split(currentLoteText, ":")(0), "LOTE")(1)))
            If currentLoteNum = loteNumToUnlock Then
                logRow = i
                found = True
                Exit For
            End If
        End If
    Next i
    
    If Not found Then
        MsgBox "El lote #" & loteNumToUnlock & " no fue encontrado en el registro.", vbExclamation
        Exit Sub
    End If
    
    Dim loteColor As Long, prodStartRow As Long, prodLastRow As Long
    loteColor = ws.Cells(logRow, "G").Interior.color
    prodLastRow = FindLastColoredRowByColor(ws, loteColor)
    prodStartRow = FindFirstColoredRowByColor(ws, loteColor, prodLastRow)
    
    If prodStartRow = 0 Or prodLastRow = 0 Then
        MsgBox "No se pudo encontrar el rango de celdas para el Lote " & loteNumToUnlock & ".", vbCritical
        Exit Sub
    End If
    
    Application.ScreenUpdating = False
    
    ws.Unprotect password:=SHEET_PASSWORD
    ws.Range("A" & prodStartRow & ":D" & prodLastRow).Locked = False
    ws.Protect password:=SHEET_PASSWORD, UserInterfaceOnly:=True
    
    Application.ScreenUpdating = True
    MsgBox "Lote " & loteNumToUnlock & " ha sido desbloqueado y ahora es editable.", vbInformation
    Call AddToHistory("DESBLOQUEO DE LOTE", "Lote " & loteNumToUnlock & " fue desbloqueado.")
End Sub

' =========================================================================
' === MACRO "Eliminar Lote" ===============================================
' =========================================================================
Sub EliminarLote()
    Dim ws As Worksheet
    Set ws = ActiveSheet
    
    Dim password As String
    password = InputBox("Esta acción es irreversible." & vbCrLf & "Ingresa la contraseña para continuar:", "Acceso Protegido")
    If password <> SHEET_PASSWORD Then
        MsgBox "Contraseña incorrecta. Operación cancelada.", vbCritical
        Exit Sub
    End If
    
    Dim loteNumStr As String, loteNumToDelete As Long, logLastRow As Long
    logLastRow = ws.Cells(ws.Rows.Count, "G").End(xlUp).row
    
    If logLastRow < LOG_START_ROW Then
        MsgBox "No hay lotes registrados para eliminar.", vbInformation
        Exit Sub
    End If
    
    loteNumStr = InputBox("Ingresa el NÚMERO del lote que deseas eliminar (ej. 3):", "Seleccionar Lote a Eliminar")
    
    If loteNumStr = "" Then Exit Sub
    If Not IsNumeric(loteNumStr) Then
        MsgBox "Por favor, ingresa solo un número.", vbExclamation
        Exit Sub
    End If
    loteNumToDelete = CLng(loteNumStr)
    
    Dim logRowToDelete As Long, i As Long, found As Boolean
    found = False
    For i = LOG_START_ROW To logLastRow
        Dim currentLoteText As String, currentLoteNum As Long
        currentLoteText = ws.Cells(i, "G").Value
        If Left(currentLoteText, 4) = "LOTE" Then
            currentLoteNum = CLng(Trim(Split(Split(currentLoteText, ":")(0), "LOTE")(1)))
            If currentLoteNum = loteNumToDelete Then
                logRowToDelete = i
                found = True
                Exit For
            End If
        End If
    Next i
    
    If Not found Then
        MsgBox "El lote #" & loteNumToDelete & " no fue encontrado en el registro.", vbExclamation
        Exit Sub
    End If
    
    If MsgBox("¿Estás seguro de que deseas eliminar permanentemente el Lote " & loteNumToDelete & "?" & vbCrLf & vbCrLf & _
              "Esta acción no se puede deshacer.", vbYesNo + vbQuestion + vbDefaultButton2, "Confirmar Eliminación") = vbNo Then
        Exit Sub
    End If
    
    Application.ScreenUpdating = False
    
    ws.Unprotect password:=SHEET_PASSWORD
    
    Dim loteColor As Long, prodStartRow As Long, prodLastRow As Long
    loteColor = ws.Cells(logRowToDelete, "G").Interior.color
    prodLastRow = FindLastColoredRowByColor(ws, loteColor)
    prodStartRow = FindFirstColoredRowByColor(ws, loteColor, prodLastRow)
    
    If prodStartRow > 0 And prodLastRow > 0 Then
        With ws.Range("A" & prodStartRow & ":D" & prodLastRow)
            .ClearContents
            .Interior.ColorIndex = xlNone
        End With
    End If
    
    ws.Range("G" & logRowToDelete & ":H" & logRowToDelete).EntireRow.Delete
    
    logLastRow = ws.Cells(ws.Rows.Count, "G").End(xlUp).row
    If logLastRow >= LOG_START_ROW Then
        For i = LOG_START_ROW To logLastRow
            Dim newLoteNum As Long
            newLoteNum = i - LOG_START_ROW + 1
            Dim cellText As String, restOfText As String
            cellText = ws.Cells(i, "G").Value
            restOfText = Mid(cellText, InStr(cellText, ":"))
            ws.Cells(i, "G").Value = "LOTE " & newLoteNum & restOfText
        Next i
    End If
    
    ws.Protect password:=SHEET_PASSWORD, UserInterfaceOnly:=True
    
    Application.ScreenUpdating = True
    MsgBox "Lote " & loteNumToDelete & " ha sido eliminado exitosamente.", vbInformation
    Call AddToHistory("ELIMINACIÓN DE LOTE", "Lote " & loteNumToDelete & " fue eliminado.")
End Sub

' =========================================================================
' === MACROS DE HISTORIAL =================================================
' =========================================================================
Sub AddToHistory(actionDescription As String, details As String)
    Dim wsHistorial As Worksheet, nextRow As Long
    On Error Resume Next
    Set wsHistorial = ThisWorkbook.Sheets("Historial")
    On Error GoTo 0
    If wsHistorial Is Nothing Then Exit Sub
    
    nextRow = wsHistorial.Cells(wsHistorial.Rows.Count, "A").End(xlUp).row + 1
    
    With wsHistorial
        .Cells(nextRow, 1).Value = Now()
        .Cells(nextRow, 2).Value = actionDescription
        .Cells(nextRow, 3).Value = details
        .Cells(nextRow, 4).Value = Application.UserName
        .Cells(nextRow, 5).Value = ActiveSheet.Name
    End With
End Sub

Sub MostrarHistorial()
    Dim password As String
    password = InputBox("Ingresa la contraseña para ver el historial:", "Acceso de Administrador")
    
    If password = SHEET_PASSWORD Then
        On Error Resume Next
        ThisWorkbook.Sheets("Historial").Visible = xlSheetVisible
        If Err.Number <> 0 Then MsgBox "La hoja 'Historial' no existe.", vbCritical
        On Error GoTo 0
    Else
        MsgBox "Contraseña incorrecta.", vbExclamation
    End If
End Sub

Sub OcultarHistorial()
    On Error Resume Next
    ThisWorkbook.Sheets("Historial").Visible = xlSheetVeryHidden
    On Error GoTo 0
End Sub

' =========================================================================
' === FUNCIONES AUXILIARES DE BÚSQUEDA ====================================
' =========================================================================
Private Function FindLastColoredRow(ws As Worksheet, colLetter As String) As Long
    Dim lastRow As Long, i As Long
    lastRow = ws.Cells(ws.Rows.Count, colLetter).End(xlUp).row
    If lastRow < 3 Then
        FindLastColoredRow = 2: Exit Function
    End If
    For i = lastRow To 3 Step -1
        If ws.Cells(i, colLetter).Interior.ColorIndex <> xlNone Then
            FindLastColoredRow = i
            Exit Function
        End If
    Next i
    FindLastColoredRow = 2
End Function

Private Function FindLastColoredRowByColor(ws As Worksheet, color As Long) As Long
    Dim lastRow As Long, i As Long
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).row
    For i = lastRow To 3 Step -1
        If ws.Cells(i, "A").Interior.color = color Then
            FindLastColoredRowByColor = i
            Exit Function
        End If
    Next i
    FindLastColoredRowByColor = 0
End Function

Private Function FindFirstColoredRowByColor(ws As Worksheet, color As Long, ByVal startSearchRow As Long) As Long
    Dim i As Long
    For i = startSearchRow To 3 Step -1
        If ws.Cells(i, "A").Interior.color <> color Then
            FindFirstColoredRowByColor = i + 1
            Exit Function
        End If
    Next i
    FindFirstColoredRowByColor = 3
End Function


