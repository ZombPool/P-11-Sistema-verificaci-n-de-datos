#Module6
Sub EntregarLote_Click()
    Dim ws As Worksheet
    Set ws = ActiveSheet
    
    ' 1. Solicitar el nombre del operador
    Dim nombreOperador As String
    nombreOperador = InputBox("Ingrese su nombre (Operador):", "Entrega de Lote a Empaque")
    
    ' Si el usuario cancela o deja en blanco, abortamos
    If Trim(nombreOperador) = "" Then Exit Sub
    
    ' 2. Solicitar la cantidad de piezas
    Dim cantidadPiezas As String
    cantidadPiezas = InputBox("Ingrese la cantidad de piezas a entregar al área de Empaque:", "Cantidad de Piezas")
    
    If Trim(cantidadPiezas) = "" Then Exit Sub
    
    ' Validar que la cantidad sea estrictamente un número
    If Not IsNumeric(cantidadPiezas) Then
        MsgBox "Por favor, ingrese un número válido para la cantidad.", vbExclamation, "Error de formato"
        Exit Sub
    End If
    
    ' 3. Desproteger la hoja temporalmente (Usa la contraseña estándar de tus hojas)
    ws.Unprotect password:="1234"
    
    ' 4. Buscar el siguiente bloque disponible a partir de la fila 37
    Dim filaDestino As Long
    filaDestino = 37
    
    ' El bucle saltará de 2 en 2 filas hasta encontrar una celda vacía en la columna G
    Do While ws.Range("G" & filaDestino).Value <> ""
        filaDestino = filaDestino + 2
        
        ' Poka-Yoke: Límite de seguridad por si la tabla se llena (Ej. límite en la fila 97)
        If filaDestino > 97 Then
            MsgBox "Se ha alcanzado el límite máximo de entregas en esta tabla.", vbCritical, "Tabla Llena"
            ws.Protect password:="1234"
            Exit Sub
        End If
    Loop
    
    Application.ScreenUpdating = False
    
    ' 5. Escribir los datos en el bloque encontrado
    ' Fila 1 (Nombre)
    ws.Range("G" & filaDestino).Value = "Op: " & UCase(nombreOperador)
    ws.Range("G" & filaDestino).Font.Bold = True
    
    ' Fila 2 (Fecha y Hora)
    ws.Range("G" & filaDestino + 1).Value = Format(Now, "dd/mm/yyyy hh:mm")
    ws.Range("G" & filaDestino + 1).Font.Italic = True
    
    ' Celdas Combinadas en H (Cantidad)
    With ws.Range("H" & filaDestino & ":H" & (filaDestino + 1))
        .Merge
        .Value = cantidadPiezas & " Pzs"
        .Font.Bold = True
        .Font.Size = 72
        .HorizontalAlignment = xlCenter
        .VerticalAlignment = xlCenter
    End With
    
    ' 6. Darle formato de tablita (Bordes) para que se vea profesional
    With ws.Range("G" & filaDestino & ":H" & (filaDestino + 1))
        .Borders(xlEdgeLeft).LineStyle = xlContinuous
        .Borders(xlEdgeTop).LineStyle = xlContinuous
        .Borders(xlEdgeBottom).LineStyle = xlContinuous
        .Borders(xlEdgeRight).LineStyle = xlContinuous
        .Borders(xlInsideHorizontal).LineStyle = xlContinuous
        .Borders(xlInsideVertical).LineStyle = xlContinuous
    End With
    
    ' 7. Volver a proteger la hoja
    ws.Protect password:="1234", _
               DrawingObjects:=True, _
               Contents:=True, _
               Scenarios:=True, _
               UserInterfaceOnly:=False
               
    Application.ScreenUpdating = True
    
    ' 8. Confirmación y registro en el historial (si aplica)
    MsgBox "Lote de " & cantidadPiezas & " piezas entregado exitosamente por " & UCase(nombreOperador) & ".", vbInformation, "Entrega Confirmada"
    
    ' Opcional: Si tienes tu función AddToHistory activa en este Excel, esto lo registrará en la bitácora oculta
    On Error Resume Next
    Call AddToHistory("ENTREGA A EMPAQUE", "Operador " & UCase(nombreOperador) & " entregó un lote de " & cantidadPiezas & " piezas.")
    On Error GoTo 0

End Sub

