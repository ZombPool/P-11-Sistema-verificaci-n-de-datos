' ======= Función para conectar la báscula =======
Function ConectarBascula() As Boolean
    Dim DCB As DCB
    Dim timeouts As COMMTIMEOUTS

    ' Cerrar conexión si ya existe
    If hPort <> 0 Then
        CloseHandle hPort
        hPort = 0
    End If

    ' Intentar abrir puerto COM6 (con dos formatos posibles)
    hPort = CreateFile("\\.\COM6", &HC0000000, 0, 0, 3, 0, 0)
    If hPort = -1 Then
        hPort = CreateFile("COM6", &HC0000000, 0, 0, 3, 0, 0)
    End If
    If hPort = -1 Then
        MsgBox "Error al abrir COM6. Código: " & Err.LastDllError & vbCrLf & _
               "1. Verifica que la báscula esté conectada" & vbCrLf & _
               "2. Que ningún otro programa use el puerto" & vbCrLf & _
               "3. Revisa el Administrador de dispositivos", vbCritical
        ConectarBascula = False
        Exit Function
    End If

    ' Configurar timeouts
    timeouts.ReadIntervalTimeout = 50
    timeouts.ReadTotalTimeoutMultiplier = 10
    timeouts.ReadTotalTimeoutConstant = 1000
    timeouts.WriteTotalTimeoutMultiplier = 0
    timeouts.WriteTotalTimeoutConstant = 0
    If SetCommTimeouts(hPort, timeouts) = 0 Then
        MsgBox "Error al configurar timeout del puerto", vbExclamation
        CloseHandle hPort
        hPort = 0
        ConectarBascula = False
        Exit Function
    End If

    ' Configurar parámetros del puerto
    DCB.DCBlength = Len(DCB)

    If GetCommState(hPort, DCB) = 0 Then
        MsgBox "Error al obtener configuración del puerto", vbExclamation
        CloseHandle hPort
        hPort = 0
        ConectarBascula = False
        Exit Function
    End If

    DCB.BaudRate = 9600
    DCB.ByteSize = 8
    DCB.Parity = 0
    DCB.StopBits = 1
    DCB.fBitFields = &H1

    If SetCommState(hPort, DCB) = 0 Then
        MsgBox "Error en configuración del puerto. Código: " & Err.LastDllError & vbCrLf & _
               "Prueba cambiar:" & vbCrLf & _
               "- BaudRate a 2400" & vbCrLf & _
               "- Parity a 1 (Odd parity)", vbExclamation
        CloseHandle hPort
        hPort = 0
        ConectarBascula = False
    Else
        ConectarBascula = True
        MsgBox "Conexión establecida correctamente con COM6", vbInformation
    End If
End Function

' ======= Función para procesar datos recibidos de la báscula =======
Function ProcesarDatosBascula(datos As String) As String
    Dim cleanedData As String
    Dim i As Integer
    Dim char As String
    Dim pesoPos As Integer
    Dim pesoEnd As Integer
    Dim peso As String
    Dim regex As Object
    Dim matches As Object

    For i = 1 To Len(datos)
        char = Mid(datos, i, 1)
        If char Like "[0-9.]" Or LCase(char) Like "[wtkg]" Then
            cleanedData = cleanedData & char
        End If
    Next i

    On Error Resume Next
    Set regex = CreateObject("VBScript.RegExp")
    regex.Pattern = "\d+\.\d{1,3}"
    regex.Global = True

    pesoPos = InStr(1, cleanedData, "WT:", vbTextCompare)
    If pesoPos = 0 Then pesoPos = InStr(1, cleanedData, "W:T", vbTextCompare)
    If pesoPos = 0 Then pesoPos = InStr(1, cleanedData, "W", vbTextCompare)

    If pesoPos > 0 Then
        pesoEnd = InStr(pesoPos, cleanedData, "k", vbTextCompare)
        If pesoEnd = 0 Then pesoEnd = Len(cleanedData)
        peso = Mid(cleanedData, pesoPos, pesoEnd - pesoPos)
        If regex.Test(peso) Then
            Set matches = regex.Execute(peso)
            ProcesarDatosBascula = Format(matches(0).Value, "0.000")
            Exit Function
        End If
    End If

    If regex.Test(cleanedData) Then
        Set matches = regex.Execute(cleanedData)
        ProcesarDatosBascula = Format(matches(0).Value, "0.000")
        Exit Function
    End If

    ProcesarDatosBascula = ""
End Function

' ======= Sub para leer datos y registrar peso en hoja =======
Sub LeerYRegistrarPeso()
    Dim buffer As String * 256
    Dim bytesRead As Long
    Dim peso As String
    Dim ws As Worksheet
    Dim ultimaFila As Long
    Dim numSecuencia As Long
    
    'Verificar OT'
    If OrdenTrabajoActual = "" Then
    RegistrarOrdenDeTrabajo
    If OrdenTrabajoActual = "" Then Exit Sub
End If

    ' Verificar operador
    If OperadorActual = "" Then
        MsgBox "Debe registrar un operador primero", vbExclamation
        ' Aquí debes implementar tu procedimiento para registrar operador
        ' RegistrarOperador
        If OperadorActual = "" Then Exit Sub
    End If

    ' Verificar conexión
    If hPort = 0 Then
        If Not ConectarBascula() Then Exit Sub
    End If

    ' Leer datos
    If ReadFile(hPort, buffer, 256, bytesRead, 0) = 0 Then
        MsgBox "Error al leer datos", vbExclamation
        Exit Sub
    End If

    'Procesar datos recibios'
    If bytesRead > 0 Then
        peso = ProcesarDatosBascula(Left(buffer, bytesRead))
        If peso <> "" Then
            On Error Resume Next
            Set ws = ThisWorkbook.Sheets("Registro de pesos por caja")
            If ws Is Nothing Then
                Set ws = ThisWorkbook.Sheets.Add(After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count))
                ws.Name = "Registro de pesos por caja"
                ws.Range("A1:D1").Value = Array("Orden de Trabajo", "Fecha y Hora", "Peso (kg)", "Operador")
                With ws.Range("A1:D1")
                    .Font.Bold = True
                    .HorizontalAlignment = xlCenter
                    .Interior.color = RGB(191, 191, 191)
                End With
            End If
            On Error GoTo 0


            ultimaFila = ws.Cells(ws.Rows.Count, "A").End(xlUp).row + 1
            If ultimaFila = 2 And IsEmpty(ws.Range("A1")) Then ultimaFila = 1

            With ws
                If ultimaFila = 1 Then
                    .Range("A1:D1").Value = Array("Orden de Trabajo", "Fecha y Hora", "Peso (kg)", "Operador")
                    With .Range("A1:D1")
                        .Font.Bold = True
                        .HorizontalAlignment = xlCenter
                        .Interior.color = RGB(191, 191, 191)
                    End With
                    ultimaFila = 2
                End If

                .Cells(ultimaFila, 1).Value = OrdenTrabajoActual ' Dejar para orden de trabajo, si quieres llenar después
                .Cells(ultimaFila, 2).Value = Now
                .Cells(ultimaFila, 3).Value = CDbl(peso)
                .Cells(ultimaFila, 4).Value = OperadorActual

                .Cells(ultimaFila, 2).NumberFormat = "dd/mm/yyyy hh:mm:ss"
                .Cells(ultimaFila, 3).NumberFormat = "0.000"
                .Columns("A:D").AutoFit

                If Not .ScrollArea = "" Then
                    .Activate
                    .Range("A2").Select
                    ActiveWindow.FreezePanes = True
                End If
            End With

            MsgBox "Peso registrado correctamente: " & peso & " kg" & vbCrLf & _
                   "Operador: " & OperadorActual, vbInformation
        Else
            MsgBox "No se pudo interpretar el peso. Datos recibidos: " & Left(buffer, bytesRead), vbExclamation
        End If
    Else
        MsgBox "No se recibieron datos de la báscula", vbInformation
    End If
End Sub

