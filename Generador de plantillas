#Sheet1 (Generador de plantillas)
Sub GenerarPlantilla()
    Dim wsPlantilla As Worksheet
    Dim wsNueva As Worksheet
    Dim nombreNuevaHoja As String
    Dim nombreHoja As String
    Dim longitudCable As Integer
    Dim celdasCombinar As Integer
    Dim numOrden As String
    Dim dictConfig As Object
    Dim i As Integer, repeticiones As Integer
    Dim isValidFormat As Boolean
    Dim totalPiezas As Long
    Dim residuo As Integer
    
    ' Configurar diccionario con la relación longitud/celdas a combinar
    Set dictConfig = CreateObject("Scripting.Dictionary")
    With dictConfig
        .Add 1, 130
        .Add 6, 80
        .Add 8, 70
        .Add 10, 65
        .Add 15, 55
        .Add 20, 50
        .Add 25, 40
        .Add 27, 40
        .Add 30, 40
        .Add 35, 40
        .Add 40, 35
        .Add 45, 30
        .Add 50, 25
        .Add 55, 24
        .Add 60, 24
        .Add 65, 22
        .Add 70, 22
        .Add 75, 20
        .Add 80, 18
        .Add 85, 15
        .Add 90, 15
        .Add 95, 15
        .Add 100, 12
        .Add 110, 12
        .Add 120, 10
        .Add 130, 10
        .Add 140, 9
        .Add 150, 9
        .Add 160, 8
        .Add 170, 8
        .Add 180, 8
        .Add 190, 7
        .Add 200, 7
        .Add 210, 6
        .Add 220, 5
        .Add 230, 5
        .Add 240, 5
        .Add 250, 4
    End With
    
    On Error GoTo ErrorHandler
    
    ' Configuración inicial
    Application.ScreenUpdating = False
    
    ' Verificar si existe la hoja PLANTILLA
    If Not WorksheetExists("PLANTILLA") Then
        MsgBox "No se encontró la hoja 'PLANTILLA' en este libro", vbCritical
        Exit Sub
    End If
    
    ' Obtener número de orden de trabajo
    numOrden = ThisWorkbook.Sheets("Generador de plantillas").Range("A4").Value
    If Trim(numOrden) = "" Then
        MsgBox "¡ADVERTENCIA!" & vbCrLf & vbCrLf & _
               "Por favor ingrese el número de orden de trabajo en la celda A4." & vbCrLf & _
               "Formato aceptado: JRMO-9dígitos o JMO-9dígitos", _
               vbExclamation, "Falta número de orden"
        Exit Sub
    End If
    
    ' Validar formato del número de orden
    isValidFormat = False
    If Len(numOrden) >= 14 And Left(numOrden, 5) = "JRMO-" Then
        If IsNumeric(Mid(numOrden, 6, 9)) Then
            isValidFormat = True
        End If
    ElseIf Len(numOrden) >= 13 And Left(numOrden, 4) = "JMO-" Then
        If IsNumeric(Mid(numOrden, 5, 9)) Then
            isValidFormat = True
        End If
    End If
    
    If Not isValidFormat Then
        MsgBox "¡FORMATO INCORRECTO!" & vbCrLf & vbCrLf & _
               "El número de orden debe tener formato:" & vbCrLf & _
               "- JMRO-9dígitos (ejemplo: JMRO-250200005)" & vbCrLf & _
               "- JMO-9dígitos (ejemplo: JMO-250300001)", _
               vbExclamation, "Formato inválido"
        Exit Sub
    End If
    
    ' --- VERIFICAR SI LA ORDEN YA EXISTE ---
    If OrdenExiste(numOrden) Then
        Dim respuesta As Integer
        respuesta = MsgBox("¡ADVERTENCIA!" & vbCrLf & vbCrLf & _
                  "Estás a punto de crear una plantilla con una orden de trabajo ya existente." & vbCrLf & _
                  "Orden: " & numOrden & vbCrLf & vbCrLf & _
                  "¿Deseas continuar?", _
                  vbExclamation + vbYesNo, "Orden duplicada")
        
        If respuesta = vbNo Then
            Exit Sub
        End If
    End If
    
    ' Obtener longitud del cable
    If IsEmpty(ThisWorkbook.Sheets("Generador de plantillas").Range("C4").Value) Then
        MsgBox "Por favor seleccione la longitud del cable en la celda C4", vbExclamation
        Exit Sub
    End If
    longitudCable = ThisWorkbook.Sheets("Generador de plantillas").Range("C4").Value
    
    ' Verificar que la longitud sea válida
    If Not dictConfig.Exists(longitudCable) Then
        MsgBox "Longitud de cable no válida. Por favor seleccione una de las opciones disponibles.", vbExclamation
        Exit Sub
    End If
    
    ' Obtener número de celdas a combinar según la longitud
    celdasCombinar = dictConfig(longitudCable)
    
    ' Obtener cantidad total de piezas a escanear
    If IsEmpty(ThisWorkbook.Sheets("Generador de plantillas").Range("D4").Value) Then
        MsgBox "Por favor ingrese la cantidad total de piezas a escanear en la celda D4", vbExclamation
        Exit Sub
    End If
    totalPiezas = ThisWorkbook.Sheets("Generador de plantillas").Range("D4").Value
    
    ' Cálculo dinámico de repeticiones
    repeticiones = Int(totalPiezas / celdasCombinar)
    residuo = totalPiezas Mod celdasCombinar
    If residuo > 0 Then repeticiones = repeticiones + 1
    
    ' Generar nombre de hoja (sin prefijo JRMO-/JMO-)
    Dim ordenLimpio As String
    If Left(numOrden, 5) = "JRMO-" Then
        ordenLimpio = Mid(numOrden, 6, 9)
    Else
        ordenLimpio = Mid(numOrden, 5, 9)
    End If
    nombreHoja = "ORD-" & ordenLimpio & "-" & longitudCable & "FT"
    nombreNuevaHoja = nombreHoja & "-" & Format(Now(), "yyyymmdd")
    
    ' Verificar si el nombre ya existe y hacerlo único
    i = 1
    While WorksheetExists(nombreNuevaHoja)
        nombreNuevaHoja = nombreHoja & "-" & Format(Now(), "yyyymmdd") & "-" & i
        i = i + 1
        If i > 99 Then Exit Sub
    Wend
    
    ' Copiar la plantilla
    Set wsPlantilla = ThisWorkbook.Sheets("PLANTILLA")
    wsPlantilla.Copy After:=ThisWorkbook.Sheets(ThisWorkbook.Sheets.Count)
    Set wsNueva = ActiveSheet
    Call CopiarEventosDeHoja(wsPlantilla, wsNueva)
    wsNueva.Unprotect password:="1234" ' <-- NUEVO: Quitar candado para armar la hoja
    ' Copiar los botones de la plantilla original
    Dim btnProd As OLEObject, btnCalidad As OLEObject
    For Each oleObj In wsPlantilla.OLEObjects
        If TypeName(oleObj.Object) = "CommandButton" Then
            oleObj.Copy
            wsNueva.Paste
            ' Posicionar los botones (ajusta estas coordenadas)
            With wsNueva.OLEObjects(wsNueva.OLEObjects.Count)
                .Top = 100    ' Posición vertical
                .Left = 400   ' Posición horizontal
                If oleObj.Name = "ConfirmacionProduccion" Then
                    .Name = "ConfirmProd_" & nombreNuevaHoja
                ElseIf oleObj.Name = "ConfirmacionCalidad" Then
                    .Name = "ConfirmCal_" & nombreNuevaHoja
                End If
            End With
        End If
    Next oleObj
    
    ' Renombrar hoja
    On Error Resume Next
    wsNueva.Name = nombreNuevaHoja
    If Err.Number <> 0 Then
        nombreNuevaHoja = "PLANTILLA-" & Format(Now(), "yyyymmdd-hhnnss")
        wsNueva.Name = nombreNuevaHoja
    End If
    On Error GoTo ErrorHandler
    
    ' Combinar celdas según el cálculo dinámico
    CombinarCeldasDinamico wsNueva, celdasCombinar, repeticiones, residuo

    ' Crear botones de impresión de peso
    CrearBotonesImprimirPeso wsNueva, celdasCombinar, repeticiones, residuo
    
    ' Configuración adicional
    With wsNueva
        .Range("G1").Value = numOrden
        .Range("G1").Font.Bold = True
        .Range("C4").Value = longitudCable
        .Range("G2").Value = "Cantidad de productos a escanear: " & totalPiezas
        .Range("G2").Font.Bold = True
    End With
    
    ' Finalización
    ' <-- NUEVO: Poner candado bloqueando a humanos pero permitiendo a las macros
    wsNueva.Protect password:="1234", UserInterfaceOnly:=True
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    
    MsgBox "Plantilla generada exitosamente:" & vbCrLf & _
           "Orden: " & numOrden & vbCrLf & _
           "Longitud: " & longitudCable & " pies" & vbCrLf & _
           "Total piezas: " & totalPiezas & vbCrLf & _
           "Total de empaques: " & repeticiones & " Cajas (última: " & IIf(residuo > 0, residuo, celdasCombinar) & " productos)" & vbCrLf & _
           "Nombre hoja: " & nombreNuevaHoja, vbInformation
    Exit Sub
    
Call CrearBotonesImprimirPeso(wsNueva, celdasCombinar, repeticiones, residuo)
    
ErrorHandler:
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True
    MsgBox "Error al generar plantilla:" & vbCrLf & Err.Description, vbCritical
    
    Call AddToHistory("GENERAR PLANTILLA", "Se creó la hoja '" & nombreNuevaHoja & "' para la orden " & numOrden)
End Sub
Sub CopiarEventosDeHoja(hojaOrigen As Worksheet, hojaDestino As Worksheet)
    ' Esta función copia los eventos de una hoja a otra
    ' Se requiere acceso al modelo de objetos VBA
    On Error Resume Next
    Dim lineaInicio As Long, lineaFin As Long
    Dim codigo As String
    
    With ThisWorkbook.VBProject.VBComponents(hojaOrigen.CodeName).CodeModule
        lineaInicio = .ProcStartLine("Worksheet_Change", vbext_pk_Proc)
        lineaFin = .ProcCountLines("Worksheet_Change", vbext_pk_Proc)
        codigo = .Lines(lineaInicio, lineaFin)
    End With
    
    With ThisWorkbook.VBProject.VBComponents(hojaDestino.CodeName).CodeModule
        .DeleteLines .ProcStartLine("Worksheet_Change", vbext_pk_Proc), _
                     .ProcCountLines("Worksheet_Change", vbext_pk_Proc)
        .AddFromString codigo
    End With
    On Error GoTo 0
End Sub
' --- FUNCIÓN PARA VERIFICAR ÓRDENES EXISTENTES ---
Function OrdenExiste(numOrden As String) As Boolean
    Dim ws As Worksheet
    For Each ws In ThisWorkbook.Worksheets
        ' Excluir la hoja "Generador de plantillas" y la hoja "PLANTILLA"
        If ws.Name <> "Generador de plantillas" And ws.Name <> "PLANTILLA" Then
            ' Buscar el número de orden en el nombre de la hoja
            If InStr(ws.Name, numOrden) > 0 Then
                OrdenExiste = True
                Exit Function
            End If
            ' Opcional: Buscar también en el contenido de la celda G1
            If ws.Range("G1").Value = numOrden Then
                OrdenExiste = True
                Exit Function
            End If
        End If
    Next ws
    OrdenExiste = False
End Function

' --- FUNCIÓN PARA COMBINAR CELDAS CON "CAJA X" ---
Sub CombinarCeldasDinamico(ws As Worksheet, celdasCombinar As Integer, repeticiones As Integer, residuo As Integer)
    Dim startRow As Integer
    Dim i As Integer
    Dim celdasACombinar As Integer
    
    startRow = 3 ' Fila inicial
    
    For i = 1 To repeticiones
        ' Determinar cuántas celdas combinar (última iteración usa el residuo)
        If i = repeticiones And residuo > 0 Then
            celdasACombinar = residuo
        Else
            celdasACombinar = celdasCombinar
        End If
        
        ' --- Aplicar formato a la COLUMNA E ---
        With ws.Range("E" & startRow & ":E" & (startRow + celdasACombinar - 1))
            .Merge
            .HorizontalAlignment = xlCenter
            .VerticalAlignment = xlCenter
            .Value = "Caja " & i
            .BorderAround LineStyle:=xlContinuous, Weight:=xlThin
        End With
        
        ' --- APLICAR EL MISMO FORMATO A LA COLUMNA N ---
        With ws.Range("N" & startRow & ":N" & (startRow + celdasACombinar - 1))
            .Merge
            .HorizontalAlignment = xlCenter
            .VerticalAlignment = xlCenter
            .Value = "Caja " & i
            .BorderAround LineStyle:=xlContinuous, Weight:=xlThin
        End With
        
        startRow = startRow + celdasACombinar
    Next i
End Sub

' --- FUNCIÓN PARA VERIFICAR SI UNA HOJA EXISTE ---
Function WorksheetExists(sheetName As String) As Boolean
    On Error Resume Next
    WorksheetExists = (ThisWorkbook.Sheets(sheetName).Name <> "")
    On Error GoTo 0
End Function

Sub CrearBotonesImprimirPeso(ws As Worksheet, celdasCombinar As Integer, repeticiones As Integer, residuo As Integer)
    Dim startRow As Integer
    Dim i As Integer
    Dim btn As Button
    Dim topPosition As Double
    Dim leftPosition As Double
    
    On Error Resume Next
    startRow = 2
    leftPosition = ws.Range("F1").Left + 5 ' Ajuste de posición
    
    For i = 1 To repeticiones
        ' Calcular posición vertical
        topPosition = ws.Range("E" & startRow).Top + (ws.Range("E" & startRow).Height / 2) - 10
        
        ' Crear botón de formulario (más compatible)
        Set btn = ws.Buttons.Add(Left:=leftPosition, _
                                Top:=topPosition, _
                                Width:=100, _
                                Height:=50)
        
        With btn
            .Name = "btnImprimir_" & i
            .Caption = "Imprimir Peso"
            .Font.Size = 15
            .OnAction = "'ImprimirEtiquetaDesdeBarTender'"
        End With
        
        startRow = startRow + celdasCombinar
    Next i
    On Error GoTo 0
End Sub


